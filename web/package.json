{
  "name": "mantissa-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based interactive viewer for Mantissa retirement plans (Pyodide).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8766",
    "test": "vitest run",
    "test:browser": "python3 ../scripts/spike.py",
    "typecheck": "tsc -b --pretty",
    "format": "biome format --write .",
    "lint": "biome check ."
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "preact": "^10.24.0",
    "@preact/signals": "^1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@preact/preset-vite": "^2.9.0",
    "@types/lz-string": "^1.5.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
